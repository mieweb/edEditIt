{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run edEditIt Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/samples/simple.md",
        "${workspaceFolder}/samples/comprehensive.md"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
